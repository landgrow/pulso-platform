# ============================================================
# PULSO — Variáveis de ambiente (template)
# Copie para .env.local e preencha com seus valores
# ============================================================

# --- Supabase ---
# URL da API do projeto Supabase (não o link do dashboard!)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Chave ANON (public anon key) - segura para expor no client
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Chave SERVICE_ROLE - NUNCA exponha ao frontend
# Usar APENAS em Route Handlers (server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auto-login local (opcional) ---
# Só funciona rodando `npm run dev` (NODE_ENV=development) — nunca ativa num
# build de produção. Preenchendo os dois, o middleware loga automaticamente
# com essa conta sempre que não houver sessão, sem precisar passar pela tela
# de login durante o desenvolvimento. Deixe em branco pra manter o login
# normal mesmo em dev.
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=

# --- E2E (Playwright) ---
# Credenciais de um usuário de teste dedicado — NUNCA um usuário/cliente real.
# Ver docs/testing/e2e-setup.md para o passo a passo de criação.
# Sem essas variáveis, os testes e2e que dependem de login são pulados
# automaticamente (não falham).
PULSO_E2E_EMAIL=
PULSO_E2E_PASSWORD=
PULSO_E2E_ORG_SLUG=e2e-test

# --- Avisos autônomos (cron diário + eventos na hora) ---
# Vercel Cron envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Sem RESEND_API_KEY o job roda e não finge envio.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=PULSO Land Grow <noreply@landgrow.com.br>

# --- Google Drive da Land Grow ---
# OAuth em https://console.cloud.google.com — API Drive + tela de consentimento.
# Redirect: {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
